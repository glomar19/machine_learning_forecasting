table(Wage$maritl)
library(ISLR2)
library(boot)
data(Wage)
# 1
set.seed(4)
deltas.poly <- c()
for (i in 1:10) {
fit <- glm(wage ~ poly(age, i, raw = TRUE), data = Wage)
cv_error <- cv.glm(Wage, fit, K = 10)$delta[1]
deltas.poly[i] <- cv_error
}
plot(deltas.poly)
d.min.poly <- which.min(deltas.poly)
fit1 <- lm(wage ~ age, data = Wage)
fit2 <- glm(wage ~ poly(age, 2), data = Wage)
fit3 <- lm(wage ~ poly(age, 3), data = Wage)
fit4 <- lm(wage ~ poly(age, 4), data = Wage)
fit5 <- lm(wage ~ poly(age, 5), data = Wage)
anova.poly <- anova(fit1,fit2, fit3, fit4, fit5)
anova.poly
summary(anova.poly)
# 2
set.seed(1)
deltas.cut <- c()
for (i in 2:10) {
Wage$age.cut <- cut(Wage$age, i)
fit <- glm(wage ~ age.cut, data = Wage)
cv_error <- cv.glm(Wage, fit, K = 10)$delta[1]
deltas.cut[i] <- cv_error
}
plot(deltas.cut)
d.min.cut <- which.min(deltas.cut)
plot(Wage$wage, Wage$age)
age.grid <- seq(range(age)[1],range(age)[2])
fit8 <- lm(wage ~ cut(age, breaks = 8), data = Wage)
preds<-predict(fit8,newdata=list(age=age.grid))
table(Wage$maritl)
table(Wage$jobclass)
boxplot(wage ~ maritl, data = Wage)
boxplot(wage ~ jobclass, data = Wage)
MC1 <- 2
MC2 <- 2
fit1 <- gam(wage~lo(year, span = 0.7)+ s(age, 5) + education, data=Wage)
fit2 <- gam(wage~lo(year, span = 0.7)+ s(age, 5) + education+jobclass, data=Wage)
fit3 <- gam(wage~lo(year, span = 0.7)+ s(age, 5)+ education + jobclass + maritl, data=Wage)
anova.wage <- anova(fit1, fit2, fit3)
anova.wage
View(fit2)
